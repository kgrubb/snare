{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "go",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "chore(release): snare ${version}",
      "pull-request-header": "Release snare",
      "extra-files": [
        {
          "type": "yaml",
          "path": "charts/snare/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "charts/snare/Chart.yaml",
          "jsonpath": "$.appVersion"
        },
        {
          "type": "yaml",
          "path": "charts/snare/values.yaml",
          "jsonpath": "$.image.tag"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "refactor",
          "section": "Changed"
        },
        {
          "type": "revert",
          "section": "Changed"
        },
        {
          "type": "build",
          "section": "Dependencies"
        }
      ]
    }
  }
}
